      background: #ECFDF5;
      border: 1.5px solid #A7F3D0;
      border-radius: var(--radius-lg);
      padding: 1.25rem;
    }
    .proof-box-header {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.92rem;
      color: #065F46;
      margin-bottom: 0.5rem;
    }
    .proof-box-desc {
      font-size: 0.82rem;
      color: #064E3B;
      line-height: 1.5;
      margin-bottom: 1rem;
    }

    /* ── Checkboxes & Agree ── */
    .checkout-agree {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      cursor: pointer;
    }
    .agree-checkbox {
      width: 19px;
      height: 19px;
      margin-top: 0.15rem;
      accent-color: var(--color-accent);
      flex-shrink: 0;
      cursor: pointer;
    }
    .agree-text {
      font-size: 0.84rem;
      color: var(--color-text-secondary);
      line-height: 1.5;
    }
    .agree-text a {
      color: var(--color-accent);
      text-decoration: none;
      font-weight: 600;
    }
    .agree-text a:hover { text-decoration: underline; }

    /* ── Sidebar Summary ── */
    .checkout-summary {
      background: linear-gradient(180deg, var(--color-surface) 0%, #FAFCF8 100%);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
      padding: 1.75rem;
      position: sticky;
      top: 100px;
      box-shadow: var(--shadow-md);
    }
    .checkout-summary-title {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--color-text);
      margin-bottom: 1.25rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--color-border);
    }
    .checkout-items {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      max-height: 280px;
      overflow-y: auto;
      padding-right: 0.25rem;
    }
    .checkout-item {
      display: flex;
      gap: 0.75rem;
      align-items: center;
    }
    .checkout-item-img {
      width: 48px;
      height: 48px;
      object-fit: contain;
      border-radius: var(--radius-sm);
      border: 1px solid var(--color-border);
      background: var(--color-surface);
      flex-shrink: 0;
    }
    .checkout-item-info { flex: 1; min-width: 0; }
    .checkout-item-title {
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--color-text);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .checkout-item-meta {
      font-size: 0.72rem;
      color: var(--color-text-muted);
      margin-top: 0.1rem;
    }
    .checkout-item-price {
      font-family: var(--font-display);
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--color-text);
      flex-shrink: 0;
    }
    .checkout-divider {
      border: none;
      border-top: 1px solid var(--color-border);
      margin: 1rem 0;
    }
    .checkout-summary-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.35rem 0;
      font-size: 0.85rem;
      color: var(--color-text-secondary);
    }
    .checkout-total-row { padding-top: 0.5rem; }
    .checkout-total-row span:first-child {
      font-size: 1rem;
      font-weight: 700;
      color: var(--color-text);
    }
    .checkout-total-row span:last-child {
      font-size: 1.25rem;
      font-weight: 800;
      color: #15803D;
    }

    .checkout-guarantees {
      margin-top: 1.5rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--color-border);
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .guarantee-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.78rem;
      color: var(--color-text-secondary);
    }
  </style>

  <script define:vars={{ minOrder, siteData, cryptos }}>
    /* ─────────────────────────────────────────────────────────
       State & Cart Helpers
       ───────────────────────────────────────────────────────── */
    function getCart() {
      try { return JSON.parse(localStorage.getItem('mrnicevape_cart') || '[]'); } catch { return []; }
    }
    function saveCart(cart) {
      localStorage.setItem('mrnicevape_cart', JSON.stringify(cart));
      window.dispatchEvent(new CustomEvent('cart-updated'));
    }

    function getVersandPreis(method) {
      return method === 'express' ? 14.95 : 9.95;
    }

    let currentStep = 1;

    function fmt(val) {
      return Number(val || 0).toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
    }

    /* ─────────────────────────────────────────────────────────
       Initial Checkout Validation & Minimum Order Enforcement
       ───────────────────────────────────────────────────────── */
    function initCheckout() {
      const cart = getCart();
      const emptyEl = document.getElementById('checkout-empty');
      const minAlertEl = document.getElementById('checkout-min-alert');
      const contentEl = document.getElementById('checkout-content');
      if (!emptyEl || !contentEl || !minAlertEl) return;

      if (cart.length === 0) {
        emptyEl.style.display = 'block';
        minAlertEl.style.display = 'none';
        contentEl.style.display = 'none';
        return;
      }

      const subtotal = cart.reduce((sum, item) => sum + (parseFloat(item.price || '0') * (item.qty || 1)), 0);
      if (subtotal < minOrder) {
        emptyEl.style.display = 'none';
        minAlertEl.style.display = 'flex';
        contentEl.style.display = 'none';
        return;
      }

      emptyEl.style.display = 'none';
      minAlertEl.style.display = 'none';
      contentEl.style.display = 'block';

      renderSummary();
      updateCryptoSelection();
    }

    /* ─────────────────────────────────────────────────────────
       Sidebar Summary Rendering
       ───────────────────────────────────────────────────────── */
    function renderSummary() {
      const cart = getCart();
      const itemsEl = document.getElementById('checkout-items');
      const subtotalEl = document.getElementById('checkout-subtotal');
      const shippingEl = document.getElementById('checkout-shipping');
      const totalEl = document.getElementById('checkout-total');
      const nettoEl = document.getElementById('checkout-netto');
      const mwstEl = document.getElementById('checkout-mwst');
      const cryptoDueEl = document.getElementById('crypto-due-eur');

      if (!itemsEl) return;

      let subtotal = 0;
      itemsEl.innerHTML = cart.map(item => {
        const line = parseFloat(item.price || '0') * (item.qty || 1);
        subtotal += line;
        return `
          <div class="checkout-item">
            ${item.image ? `<img src="${item.image}" alt="${item.title || 'Produkt'}" class="checkout-item-img" onerror="this.style.display='none'" />` : ''}
            <div class="checkout-item-info">
              <div class="checkout-item-title">${item.title}</div>
              <div class="checkout-item-meta">Menge: ${item.qty || 1} &times; ${fmt(item.price)}</div>
            </div>
            <span class="checkout-item-price">${fmt(line)}</span>
          </div>
        `;
      }).join('');

      const shipRadio = document.querySelector('input[name="shipping"]:checked');
      const shipCost = getVersandPreis(shipRadio ? shipRadio.value : 'standard');
      const total = subtotal + shipCost;

      // 19% German VAT calculation
      const netto = total / 1.19;
      const mwst = total - netto;

      if (nettoEl) nettoEl.textContent = fmt(netto);
      if (mwstEl) mwstEl.textContent = fmt(mwst);
      if (subtotalEl) subtotalEl.textContent = fmt(subtotal);
      if (shippingEl) shippingEl.textContent = fmt(shipCost);
      if (totalEl) totalEl.textContent = fmt(total);
      if (cryptoDueEl) cryptoDueEl.textContent = fmt(total);
    }

    /* ─────────────────────────────────────────────────────────
       Wizard Step Navigation
       ───────────────────────────────────────────────────────── */
    function goToStep(step) {
      currentStep = step;
      for (let i = 1; i <= 3; i++) {
        const el = document.getElementById(`step-${i}`);
        if (el) el.style.display = (i === step) ? 'block' : 'none';
      }
      document.querySelectorAll('.checkout-step[data-step]').forEach(el => {
        const s = parseInt(el.getAttribute('data-step') || '0');
        el.classList.remove('active', 'completed');
        if (s === step) el.classList.add('active');
        else if (s < step) el.classList.add('completed');
      });
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    /* ─────────────────────────────────────────────────────────
       Validation Step 1: User Info
       ───────────────────────────────────────────────────────── */
    function validateStep1() {
      const email = document.getElementById('checkout-email');
      const fname = document.getElementById('checkout-fname');
      const lname = document.getElementById('checkout-lname');
      const address = document.getElementById('checkout-address');
      const city = document.getElementById('checkout-city');
      const state = document.getElementById('checkout-state');
      const postcode = document.getElementById('checkout-postcode');

      const requiredFields = [fname, lname, address, postcode, city, state, email];
      let valid = true;

      requiredFields.forEach(f => {
        if (!f) return;
        f.style.borderColor = '';
        if (!f.value.trim()) {
          f.style.borderColor = 'var(--color-sale)';
          valid = false;
        }
      });

      if (email && (!email.value.includes('@') || !email.value.includes('.'))) {
        email.style.borderColor = 'var(--color-sale)';
        valid = false;
      }

      if (postcode && !/^[0-9]{5}$/.test(postcode.value.trim())) {
        postcode.style.borderColor = 'var(--color-sale)';
        valid = false;
      }

      if (!valid) {
        const first = requiredFields.find(f => f && f.style.borderColor !== '');
        if (first) {
          first.focus();
          first.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }

      return valid;
    }

    /* ─────────────────────────────────────────────────────────
       Validation Step 2: Shipping & Age Verification
       ───────────────────────────────────────────────────────── */
    function validateStep2() {
      const ageBox = document.getElementById('checkout-age-confirm');
      const errEl = document.getElementById('age-confirm-error');
      if (!ageBox?.checked) {
        if (errEl) errEl.style.display = 'block';
        ageBox?.focus();
        return false;
      }
      if (errEl) errEl.style.display = 'none';
      return true;
    }

    /* ─────────────────────────────────────────────────────────
       Crypto Currency Selector Logic
       ───────────────────────────────────────────────────────── */
    function updateCryptoSelection() {
      const select = document.getElementById('crypto-currency-select');
      if (!select) return;

      const opt = select.options[select.selectedIndex];
      if (!opt) return;

      const symbol = opt.getAttribute('data-symbol') || '';
      const name = opt.getAttribute('data-name') || '';
      const network = opt.getAttribute('data-network') || '';
      const address = opt.getAttribute('data-address') || '';
      const time = opt.getAttribute('data-time') || '';

      const nameEl = document.getElementById('crypto-active-name');
      const netEl = document.getElementById('crypto-active-network');
      const timeEl = document.getElementById('crypto-active-time');
      const addrEl = document.getElementById('crypto-active-address');
      const qrEl = document.getElementById('crypto-qr-img');

      if (nameEl) nameEl.textContent = `${name} (${symbol})`;
      if (netEl) netEl.textContent = `Netzwerk: ${network}`;
      if (timeEl) timeEl.textContent = `Dauer: ca. ${time}`;
      if (addrEl) addrEl.value = address;
      if (qrEl) qrEl.src = `https://api.qrserver.com/v1/create-qr-code/?size=120x120&data=${encodeURIComponent(address)}`;
    }

    /* ─────────────────────────────────────────────────────────
       Event Listeners & Initialization
       ───────────────────────────────────────────────────────── */
    initCheckout();

    // Step navigation
    document.getElementById('to-step-2')?.addEventListener('click', () => {
      if (validateStep1()) goToStep(2);
    });
    document.getElementById('back-step-1')?.addEventListener('click', () => goToStep(1));

    document.getElementById('to-step-3')?.addEventListener('click', () => {
      if (validateStep2()) {
        renderSummary();
        goToStep(3);
      }
    });
    document.getElementById('back-step-2')?.addEventListener('click', () => goToStep(2));

    // Shipping change
    document.querySelectorAll('input[name="shipping"]').forEach(r => {
      r.addEventListener('change', renderSummary);
    });

    // Payment method switcher
    const sepaPanel = document.getElementById('sepa-details-panel');
    const cryptoPanel = document.getElementById('crypto-details-panel');

    function refreshPaymentPanels() {
      const selected = document.querySelector('input[name="payment"]:checked')?.value;
      if (sepaPanel) sepaPanel.style.display = (selected === 'sepa') ? 'block' : 'none';
      if (cryptoPanel) cryptoPanel.style.display = (selected === 'crypto') ? 'block' : 'none';
      validateStep3Form();
    }

    document.querySelectorAll('input[name="payment"]').forEach(r => {
      r.addEventListener('change', refreshPaymentPanels);
    });

    // Crypto dropdown change
    document.getElementById('crypto-currency-select')?.addEventListener('change', updateCryptoSelection);

    // Crypto address copy button
    const copyBtn = document.getElementById('crypto-copy-btn');
    const copyText = document.getElementById('crypto-copy-text');
    copyBtn?.addEventListener('click', () => {
      const addrInput = document.getElementById('crypto-active-address');
      if (!addrInput) return;
      navigator.clipboard.writeText(addrInput.value).then(() => {
        if (copyText) copyText.textContent = 'Kopiert! ✓';
        setTimeout(() => { if (copyText) copyText.textContent = 'Kopieren'; }, 2500);
      }).catch(() => {
        addrInput.select();
        document.execCommand('copy');
        if (copyText) copyText.textContent = 'Kopiert! ✓';
        setTimeout(() => { if (copyText) copyText.textContent = 'Kopieren'; }, 2500);
      });
    });

    // Final Validation & Enabling "Place Order" button
    const agreeBox = document.getElementById('checkout-agree');
    const placeBtn = document.getElementById('place-order');
    const txIdInput = document.getElementById('crypto-txid-input');
    const cryptoConfirmBox = document.getElementById('crypto-paid-confirm');
    const cryptoErr = document.getElementById('crypto-proof-error');

    function validateStep3Form() {
      if (!placeBtn) return;
      const termsAccepted = !!agreeBox?.checked;
      const paymentMethod = document.querySelector('input[name="payment"]:checked')?.value;

      if (!termsAccepted) {
        placeBtn.disabled = true;
        return;
      }

      if (paymentMethod === 'crypto') {
        const txIdVal = (txIdInput?.value || '').trim();
        const paidConfirmed = !!cryptoConfirmBox?.checked;
        if (!txIdVal || txIdVal.length < 8 || !paidConfirmed) {
          placeBtn.disabled = true;
          return;
        }
      }

      placeBtn.disabled = false;
    }

    agreeBox?.addEventListener('change', validateStep3Form);
    txIdInput?.addEventListener('input', validateStep3Form);
    cryptoConfirmBox?.addEventListener('change', validateStep3Form);

    /* ─────────────────────────────────────────────────────────
       Order Placement & API Dispatch
       ───────────────────────────────────────────────────────── */
    placeBtn?.addEventListener('click', async () => {
      const cart = getCart();
      if (cart.length === 0) return;

      const subtotal = cart.reduce((sum, item) => sum + (parseFloat(item.price || '0') * (item.qty || 1)), 0);
      if (subtotal < minOrder) {
        alert('Der Mindestbestellwert von 220,00 € wurde noch nicht erreicht.');
        return;
      }

      const paymentMethod = document.querySelector('input[name="payment"]:checked')?.value || 'sepa';
      const shippingMethod = document.querySelector('input[name="shipping"]:checked')?.value || 'standard';
      const shipCost = getVersandPreis(shippingMethod);

      // Verify crypto proof requirements
      let selectedCrypto = null;
      let txId = '';
      if (paymentMethod === 'crypto') {
        const select = document.getElementById('crypto-currency-select');
        const opt = select?.options[select.selectedIndex];
        txId = (txIdInput?.value || '').trim();
        const paidConfirmed = !!cryptoConfirmBox?.checked;

        if (!txId || txId.length < 8 || !paidConfirmed) {
          if (cryptoErr) cryptoErr.style.display = 'block';
          txIdInput?.focus();
          return;
        }
        if (cryptoErr) cryptoErr.style.display = 'none';

        selectedCrypto = {
          id: select?.value,
          name: opt?.getAttribute('data-name'),
          symbol: opt?.getAttribute('data-symbol'),
          network: opt?.getAttribute('data-network'),
          address: opt?.getAttribute('data-address'),
          txId: txId
        };
      }

      // Lock button and display progress
      placeBtn.disabled = true;
      const placeText = document.getElementById('place-order-text');
      const statusEl = document.getElementById('order-submit-status');
      if (placeText) placeText.textContent = 'Bestellung wird verarbeitet...';
      if (statusEl) {
        statusEl.style.display = 'block';
        statusEl.textContent = 'Ihre Bestelldaten werden verschlüsselt übertragen...';
      }

      const orderNumber = 'VL-' + Date.now().toString(36).toUpperCase();
      const orderDate = new Date().toISOString();

      const orderData = {
        orderNumber,
        date: orderDate,
        email: (document.getElementById('checkout-email')?.value || '').trim(),
        phone: (document.getElementById('checkout-phone')?.value || '').trim(),
        firstName: (document.getElementById('checkout-fname')?.value || '').trim(),
        lastName: (document.getElementById('checkout-lname')?.value || '').trim(),
        address: (document.getElementById('checkout-address')?.value || '').trim(),
        address2: (document.getElementById('checkout-address2')?.value || '').trim(),
        city: (document.getElementById('checkout-city')?.value || '').trim(),
        state: (document.getElementById('checkout-state')?.value || '').trim(),
        postcode: (document.getElementById('checkout-postcode')?.value || '').trim(),
        shipping: shippingMethod,
        shippingCost: shipCost,
        payment: paymentMethod,
        crypto: selectedCrypto,
        txId: txId,
        notes: (document.getElementById('checkout-notes')?.value || '').trim(),
        items: cart,
        subtotal: subtotal,
        total: subtotal + shipCost,
        status: paymentMethod === 'crypto' ? 'crypto_paid_pending_verification' : 'sepa_pending'
      };

      // Store in localStorage for confirmation screen
      localStorage.setItem('mrnicevape_last_order', JSON.stringify(orderData));

      // Append to guest order history by email
      try {
        const histKey = `mrnicevape_orders_${orderData.email.toLowerCase()}`;
        const orders = JSON.parse(localStorage.getItem(histKey) || '[]');
        orders.unshift(orderData);
        localStorage.setItem(histKey, JSON.stringify(orders));
      } catch {}

      // Formulate payload for Resend email API
      const emailPayload = {
        orderNumber: orderData.orderNumber,
        date: orderData.date,
        firstName: orderData.firstName,
        lastName: orderData.lastName,
        email: orderData.email,
        phone: orderData.phone,
        address: orderData.address,
        address2: orderData.address2,
        city: orderData.city,
        state: orderData.state,
        postcode: orderData.postcode,
        items: orderData.items,
        subtotal: orderData.subtotal.toFixed(2),
        shippingMethod: shippingMethod === 'express' ? 'Expressversand (2–4 Werktage)' : 'Standardversand (5–10 Werktage)',
        shippingCost: shipCost.toFixed(2),
        total: orderData.total.toFixed(2),
        paymentMethod: paymentMethod === 'crypto'
          ? `Kryptowährung: ${selectedCrypto?.name} (${selectedCrypto?.symbol}) [Netzwerk: ${selectedCrypto?.network}]`
          : 'SEPA-Banküberweisung (Deutsche Bank)',
        status: paymentMethod === 'crypto'
          ? 'Krypto-Zahlung überwiesen (TXID beigefügt)'
          : 'SEPA-Überweisung ausstehend',
        notes: orderData.notes,
        cryptoCoin: selectedCrypto?.name,
        cryptoSymbol: selectedCrypto?.symbol,
        cryptoNetwork: selectedCrypto?.network,
        cryptoAddress: selectedCrypto?.address,
        txId: txId
      };

      // Dispatch order emails via Resend API
      try {
        const timeoutPromise = new Promise(resolve => setTimeout(resolve, 6000));
        const emailSends = [
          // 1. Customer order confirmation
          fetch('/api/send-email', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ type: 'customer-confirmation', data: emailPayload })
          }).catch(e => console.error('Customer email error:', e)),

          // 2. Admin notification to info@mrnicevape.com
          fetch('/api/send-email', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ type: 'admin-order', data: emailPayload })
          }).catch(e => console.error('Admin email error:', e))
        ];

        await Promise.race([Promise.allSettled(emailSends), timeoutPromise]);
      } catch (err) {
        console.error('Email dispatch error:', err);
      }

      // Empty shopping cart
      saveCart([]);

      // Redirect to confirmation page
      window.location.href = '/order-confirmation';
    });
  </script>

</Layout>
