---
import Layout from '../layouts/Layout.astro';
import siteData from '../data/site.json';

const minOrder = siteData.min_order || 220.00;
const cryptos = siteData.crypto_currencies || [];
---

<Layout title="Zur Kasse – Mr. Nice Vape Deutschland" description="Schließen Sie Ihre Bestellung sicher bei Mr. Nice Vape Deutschland ab." noindex={true}>

  <!-- Breadcrumb -->
  <nav class="breadcrumb-bar" aria-label="Breadcrumb">
    <div class="container">
      <ol class="breadcrumb">
        <li><a href="/">Startseite</a></li>
        <li><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg></li>
        <li><a href="/cart">Warenkorb</a></li>
        <li><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg></li>
        <li><span class="breadcrumb-current">Kasse (3-Schritte-Bestellprozess)</span></li>
      </ol>
    </div>
  </nav>

  <section class="container checkout-page">
    <!-- Empty Cart Notice -->
    <div id="checkout-empty" style="display:none;">
      <div class="checkout-empty-inner">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-dim)" stroke-width="1.2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        <h2 class="font-display" style="font-size:1.3rem;font-weight:700;color:var(--color-text);margin-top:1rem;">Ihr Warenkorb ist leer</h2>
        <p style="color:var(--color-text-secondary);font-size:0.9rem;margin-top:0.35rem;">Legen Sie zuerst Artikel in den Warenkorb (Mindestbestellwert: 220,00 €).</p>
        <a href="/collections/shop" class="btn-primary" style="margin-top:1.25rem;padding:0.75rem 2rem;">Produkte ansehen</a>
      </div>
    </div>

    <!-- Below Minimum Order Notice -->
    <div id="checkout-min-alert" style="display:none;" class="checkout-min-alert">
      <div class="checkout-min-alert-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      </div>
      <div>
        <h3 class="font-display" style="font-size:1rem;font-weight:700;color:#B45309;margin-bottom:0.25rem;">Mindestbestellwert nicht erreicht</h3>
        <p style="font-size:0.88rem;color:#78350F;margin:0;">Der Mindestbestellwert beträgt <strong>220,00 €</strong>. Ihr aktueller Warenwert reicht noch nicht aus. Bitte fügen Sie weitere Artikel im Warenkorb hinzu.</p>
        <a href="/cart" class="btn-secondary" style="margin-top:0.75rem;display:inline-flex;padding:0.5rem 1.25rem;font-size:0.85rem;">Zurück zum Warenkorb</a>
      </div>
    </div>

    <!-- Checkout Main Interface -->
    <div id="checkout-content" style="display:none;">
      <!-- Progressive 3-Step Wizard Progress Bar -->
      <div class="checkout-steps" role="navigation" aria-label="Bestellschritte">
        <div class="checkout-step active" data-step="1">
          <span class="step-num">1</span>
          <div class="step-text">
            <span class="step-label">Schritt 1</span>
            <span class="step-name">Kundeninformationen</span>
          </div>
        </div>
        <div class="step-connector"></div>
        <div class="checkout-step" data-step="2">
          <span class="step-num">2</span>
          <div class="step-text">
            <span class="step-label">Schritt 2</span>
            <span class="step-name">Versand &amp; Lieferung</span>
          </div>
        </div>
        <div class="step-connector"></div>
        <div class="checkout-step" data-step="3">
          <span class="step-num">3</span>
          <div class="step-text">
            <span class="step-label">Schritt 3</span>
            <span class="step-name">Zahlungsinformationen</span>
          </div>
        </div>
      </div>

      <div class="checkout-grid">
        <!-- Form Column -->
        <div class="checkout-form-col">

          <!-- ═══════════════════════════════════════════════════════
               SCHRITT 1: Kundeninformationen & Lieferanschrift
               ═══════════════════════════════════════════════════════ -->
          <div id="step-1" class="checkout-step-content">
            <!-- Kontaktinformationen -->
            <div class="checkout-section">
              <h2 class="font-display checkout-section-title">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                1. Kontaktinformationen (Gastbestellung)
              </h2>
              <p class="section-desc">Keine Registrierung erforderlich. Ihre Daten werden verschlüsselt übertragen und ausschließlich zur Bestellabwicklung genutzt.</p>
              
              <div class="form-row">
                <label class="form-field">
                  <span class="form-label">E-Mail-Adresse <span class="req">*</span></span>
                  <input type="email" id="checkout-email" class="form-input" placeholder="beispiel@domain.de" required autocomplete="email" />
                  <span class="field-hint">Bestellbestätigung, Zahlungsanweisung &amp; Sendungsnummer werden hierhin gesendet.</span>
                </label>
              </div>

              <div class="form-row">
                <label class="form-field">
                  <span class="form-label">Telefonnummer <span class="field-optional">(optional für Versandbenachrichtigungen)</span></span>
                  <input type="tel" id="checkout-phone" class="form-input" placeholder="+49 170 1234567" autocomplete="tel" />
                </label>
              </div>
            </div>

            <!-- Lieferadresse -->
            <div class="checkout-section">
              <h2 class="font-display checkout-section-title">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                Lieferadresse (Deutschland)
              </h2>

              <div class="form-row form-row-2">
                <label class="form-field">
                  <span class="form-label">Vorname <span class="req">*</span></span>
                  <input type="text" id="checkout-fname" class="form-input" placeholder="Max" required autocomplete="given-name" />
                </label>
                <label class="form-field">
                  <span class="form-label">Nachname <span class="req">*</span></span>
                  <input type="text" id="checkout-lname" class="form-input" placeholder="Mustermann" required autocomplete="family-name" />
                </label>
              </div>

              <div class="form-row">
                <label class="form-field">
                  <span class="form-label">Straße und Hausnummer <span class="req">*</span></span>
                  <input type="text" id="checkout-address" class="form-input" placeholder="Hauptstraße 42" required autocomplete="street-address" />
                </label>
              </div>

              <div class="form-row">
                <label class="form-field">
                  <span class="form-label">Adresszusatz / Wohnung / Packstation <span class="field-optional">(optional)</span></span>
                  <input type="text" id="checkout-address2" class="form-input" placeholder="Hinterhaus, 2. OG oder Postnummer" />
                </label>
              </div>

              <div class="form-row form-row-3">
                <label class="form-field">
                  <span class="form-label">PLZ <span class="req">*</span></span>
                  <input type="text" id="checkout-postcode" class="form-input" placeholder="50667" maxlength="5" pattern="[0-9]{5}" required autocomplete="postal-code" />
                </label>
                <label class="form-field" style="grid-column: span 1;">
                  <span class="form-label">Stadt <span class="req">*</span></span>
                  <input type="text" id="checkout-city" class="form-input" placeholder="Köln" required autocomplete="address-level2" />
                </label>
                <label class="form-field" style="grid-column: span 1;">
                  <span class="form-label">Bundesland <span class="req">*</span></span>
                  <select id="checkout-state" class="form-input form-select" required autocomplete="address-level1">
                    <option value="">Bitte wählen...</option>
                    <option value="BW">Baden-Württemberg</option>
                    <option value="BY">Bayern</option>
                    <option value="BE">Berlin</option>
                    <option value="BB">Brandenburg</option>
                    <option value="HB">Bremen</option>
                    <option value="HH">Hamburg</option>
                    <option value="HE">Hessen</option>
                    <option value="MV">Mecklenburg-Vorpommern</option>
                    <option value="NI">Niedersachsen</option>
                    <option value="NW" selected>Nordrhein-Westfalen</option>
                    <option value="RP">Rheinland-Pfalz</option>
                    <option value="SL">Saarland</option>
                    <option value="SN">Sachsen</option>
                    <option value="ST">Sachsen-Anhalt</option>
                    <option value="SH">Schleswig-Holstein</option>
                    <option value="TH">Thüringen</option>
                  </select>
                </label>
              </div>

              <div class="form-row">
                <label class="form-field">
                  <span class="form-label">Land</span>
                  <input type="text" class="form-input" value="Deutschland" disabled style="background:var(--color-surface-alt);color:var(--color-text-muted);cursor:not-allowed;" />
                </label>
              </div>
            </div>

            <!-- Actions Step 1 -->
            <div class="form-actions">
              <a href="/cart" class="btn-secondary" style="padding:0.75rem 1.5rem;text-decoration:none;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
                Warenkorb bearbeiten
              </a>
              <button type="button" id="to-step-2" class="btn-primary" style="padding:0.75rem 2rem;">
                Weiter zu Schritt 2: Versand &amp; Lieferung
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </button>
            </div>
          </div>

          <!-- ═══════════════════════════════════════════════════════
               SCHRITT 2: Versand & Lieferung
               ═══════════════════════════════════════════════════════ -->
          <div id="step-2" class="checkout-step-content" style="display:none;">
            <div class="checkout-section">
              <h2 class="font-display checkout-section-title">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><path d="m16 8 4 2v6H16"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                2. Versandart auswählen
              </h2>
              <p class="section-desc">Alle Pakete werden ab unserem Kölner Lager bruchsicher verpackt und neutral mit Sendungsverfolgung versendet.</p>

              <div class="shipping-options">
                <label class="shipping-option">
                  <input type="radio" name="shipping" value="standard" checked class="shipping-radio" />
                  <div class="shipping-option-content">
                    <div class="shipping-radio-custom"></div>
                    <div style="flex:1;">
                      <div class="shipping-header-row">
                        <span class="shipping-name">Standardversand (DHL / Deutsche Post)</span>
                        <span class="shipping-badge">Beliebt</span>
                      </div>
                      <span class="shipping-time">Laufzeit 5–10 Werktage &middot; Inkl. Sendungsverfolgung &amp; Versicherung</span>
                    </div>
                    <span class="shipping-price font-display">9,95&nbsp;€</span>
                  </div>
                </label>

                <label class="shipping-option">
                  <input type="radio" name="shipping" value="express" class="shipping-radio" />
                  <div class="shipping-option-content">
                    <div class="shipping-radio-custom"></div>
                    <div style="flex:1;">
                      <div class="shipping-header-row">
                        <span class="shipping-name">Expressversand (Priorisierte Bearbeitung)</span>
                        <span class="shipping-badge express">Schnell</span>
                      </div>
                      <span class="shipping-time">Laufzeit 2–4 Werktage &middot; Bevorzugte Kommissionierung &amp; Prio-Tracking</span>
                    </div>
                    <span class="shipping-price font-display">14,95&nbsp;€</span>
                  </div>
                </label>
              </div>
            </div>

            <!-- Anmerkungen zur Bestellung -->
            <div class="checkout-section">
              <h2 class="font-display checkout-section-title">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                Lieferhinweise &amp; Anmerkungen <span class="field-optional">(optional)</span>
              </h2>
              <textarea id="checkout-notes" class="form-input form-textarea" placeholder="z. B. Bitte beim Nachbarn abgeben oder Wunschanlieferung..." rows="3"></textarea>
            </div>

            <!-- Mandatory Age Verification Check -->
            <div class="checkout-section" style="background:#FFFDF7;border-color:#FDE68A;">
              <label class="checkout-agree" style="margin:0;">
                <input type="checkbox" id="checkout-age-confirm" class="agree-checkbox" />
                <span class="agree-text">
                  <strong style="color:#B45309;">Gesetzliche Altersprüfung (18+):</strong> Ich bestätige verbindlich, dass ich mindestens 18 Jahre alt bin. Die Auslieferung erfolgt ausschließlich an volljährige Personen gemäß § 10 Jugendschutzgesetz (JuSchG) mit Alterssichtprüfung bei Zustellung. <span class="req">*</span>
                </span>
              </label>
              <div id="age-confirm-error" style="display:none;color:#DC2626;font-size:0.8rem;margin-top:0.5rem;font-weight:600;">
                Bitte bestätigen Sie Ihr Mindestalter von 18 Jahren, um fortzufahren.
              </div>
            </div>

            <!-- Actions Step 2 -->
            <div class="form-actions">
              <button type="button" id="back-step-1" class="btn-secondary" style="padding:0.75rem 1.5rem;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
                Zurück zu Kundeninformationen
              </button>
              <button type="button" id="to-step-3" class="btn-primary" style="padding:0.75rem 2rem;">
                Weiter zu Schritt 3: Zahlungsmethode
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </button>
            </div>
          </div>

          <!-- ═══════════════════════════════════════════════════════
               SCHRITT 3: Zahlungsinformationen
               ═══════════════════════════════════════════════════════ -->
          <div id="step-3" class="checkout-step-content" style="display:none;">
            <div class="checkout-section">
              <h2 class="font-display checkout-section-title">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2"/><path d="M1 10h22"/></svg>
                3. Zahlungsmethode wählen
              </h2>
              <p class="section-desc">Wählen Sie Ihre bevorzugte Zahlungsart. Für Kryptozahlungen führen Sie bitte die Transaktion durch und geben Sie die Transaktions-ID an.</p>

              <!-- Payment Method Selection Grid -->
              <div class="payment-methods-grid">
                
                <!-- Option A: Credit Card (UNDER MAINTENANCE) -->
                <div class="payment-card payment-disabled" id="method-card-cc">
                  <div class="payment-card-header">
                    <div class="payment-card-title-wrap">
                      <span class="payment-card-title">Kreditkarte (Visa, Mastercard, AMEX)</span>
                      <span class="badge-maintenance">In Wartungsarbeiten</span>
                    </div>
                    <div class="payment-icons-row">
                      <span class="pay-icon-tag">VISA</span>
                      <span class="pay-icon-tag">Mastercard</span>
                      <span class="pay-icon-tag">AMEX</span>
                    </div>
                  </div>
                  <div class="payment-maintenance-notice">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <div>
                      <strong>Karten-Terminal vorübergehend in Wartung</strong>
                      <p style="margin-top:0.2rem;font-size:0.8rem;color:#78350F;line-height:1.45;">Unser Kreditkarten-Zahlungsgateway wird derzeit sicherheitstechnisch aktualisiert. Bitte wählen Sie nachfolgend <strong>SEPA-Überweisung</strong> oder <strong>Kryptowährung</strong>.</p>
                    </div>
                  </div>
                </div>

                <!-- Option B: SEPA Banküberweisung -->
                <label class="payment-card payment-selectable" id="method-card-sepa">
                  <input type="radio" name="payment" value="sepa" checked class="payment-radio" />
                  <div class="payment-card-body">
                    <div class="payment-card-header">
                      <div class="payment-card-title-wrap">
                        <div class="payment-radio-custom"></div>
                        <span class="payment-card-title">SEPA-Banküberweisung</span>
                        <span class="badge-recommended">Klassisch &amp; Sicher</span>
                      </div>
                      <span class="pay-icon-tag font-display" style="background:#00B2A9;color:#fff;font-weight:800;border:none;">SEPA</span>
                    </div>
                    <p class="payment-card-desc">Überweisung auf unser deutsches Firmenkonto bei der Deutschen Bank. Auslieferung erfolgt nach Gutschrift.</p>

                    <!-- SEPA Details Panel (shown when checked) -->
                    <div id="sepa-details-panel" class="payment-subpanel">
                      <div class="bank-details-box">
                        <div class="bank-details-title">Bankverbindung für Ihre Überweisung:</div>
                        <div class="bank-row">
                          <span class="bank-k">Empfänger:</span>
                          <span class="bank-v">{siteData.bank_details.account_name}</span>
                        </div>
                        <div class="bank-row">
                          <span class="bank-k">Kreditinstitut:</span>
                          <span class="bank-v">{siteData.bank_details.bank_name}</span>
                        </div>
                        <div class="bank-row">
                          <span class="bank-k">IBAN:</span>
                          <span class="bank-v font-display" style="letter-spacing:1px;font-weight:700;">{siteData.bank_details.iban}</span>
                        </div>
                        <div class="bank-row">
                          <span class="bank-k">BIC:</span>
                          <span class="bank-v font-display">{siteData.bank_details.bic}</span>
                        </div>
                        <div class="bank-row">
                          <span class="bank-k">Verwendungszweck:</span>
                          <span class="bank-v" style="color:#B45309;font-weight:700;">Ihre Bestellnummer (wird gleich generiert)</span>
                        </div>
                      </div>
                    </div>
                  </div>
                </label>

                <!-- Option C: Multi-Cryptocurrency Payment -->
                <label class="payment-card payment-selectable" id="method-card-crypto">
                  <input type="radio" name="payment" value="crypto" class="payment-radio" />
                  <div class="payment-card-body">
                    <div class="payment-card-header">
                      <div class="payment-card-title-wrap">
                        <div class="payment-radio-custom"></div>
                        <span class="payment-card-title">Kryptowährung (Sofortbearbeitung)</span>
                        <span class="badge-fast">Schnell &amp; Diskret</span>
                      </div>
                      <div class="crypto-coin-pills">
                        <span class="coin-pill btc">BTC</span>
                        <span class="coin-pill eth">ETH</span>
                        <span class="coin-pill usdt">USDT</span>
                        <span class="coin-pill sol">SOL</span>
                        <span class="coin-pill xmr">XMR</span>
                      </div>
                    </div>
                    <p class="payment-card-desc">Unterstützt Bitcoin, Ethereum, USDT (TRC-20 / ERC-20), USDC, Solana und Monero. Schnelle Freigabe und priorisierte Bearbeitung.</p>

                    <!-- Crypto Details & Payment Verification Panel -->
                    <div id="crypto-details-panel" class="payment-subpanel" style="display:none;">
                      
                      <!-- Coin Selector Tabs/Select -->
                      <div class="crypto-selector-wrap">
                        <label class="form-label" style="margin-bottom:0.4rem;display:block;">Wählen Sie Ihre Kryptowährung:</label>
                        <select id="crypto-currency-select" class="form-input form-select" style="font-weight:600;font-size:0.92rem;">
                          {cryptos.map((coin: any) => (
                            <option value={coin.id} data-symbol={coin.symbol} data-name={coin.name} data-network={coin.network} data-address={coin.address} data-time={coin.time}>
                              {coin.name} ({coin.symbol}) &middot; Netzwerk: {coin.network} [ca. {coin.time}]
                            </option>
                          ))}
                        </select>
                      </div>

                      <!-- Active Coin Display Card -->
                      <div class="crypto-active-card">
                        <div class="crypto-active-meta">
                          <div>
                            <span id="crypto-active-name" class="font-display" style="font-size:1.05rem;font-weight:700;color:var(--color-text);">Bitcoin (BTC)</span>
                            <div class="crypto-active-badges">
                              <span id="crypto-active-network" class="crypto-meta-pill">Netzwerk: Bitcoin</span>
                              <span id="crypto-active-time" class="crypto-meta-pill">Dauer: 10–30 Min.</span>
                            </div>
                          </div>
                          <div class="crypto-qr-wrap">
                            <img id="crypto-qr-img" src={`https://api.qrserver.com/v1/create-qr-code/?size=120x120&data=${encodeURIComponent(cryptos[0]?.address || '')}`} alt="Krypto QR-Code" width="96" height="96" class="crypto-qr-img" />
                          </div>
                        </div>

                        <!-- Address copy box -->
                        <div class="crypto-address-container">
                          <span class="form-label">Ziel-Wallet-Adresse für Ihre Einzahlung:</span>
                          <div class="crypto-address-row">
                            <input type="text" id="crypto-active-address" class="crypto-address-input" readonly value={cryptos[0]?.address || ''} />
                            <button type="button" id="crypto-copy-btn" class="crypto-copy-btn" title="Adresse kopieren">
                              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                              <span id="crypto-copy-text">Kopieren</span>
                            </button>
                          </div>
                        </div>

                        <!-- Amount hint -->
                        <div class="crypto-amount-notice">
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                          <span>Überweisen Sie den exakten Gegenwert von <strong id="crypto-due-eur">€0,00</strong> an die oben angegebene Wallet.</span>
                        </div>
                      </div>

                      <!-- ⚡ CRITICAL RULE: USER MUST PAY AND SUBMIT TXID BEFORE ORDER IS RECEIVED -->
                      <div class="crypto-payment-proof-box">
                        <div class="proof-box-header">
