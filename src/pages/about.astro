---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Über uns — Mr. Nice Vape Deutschland | Vape-Shop aus Köln" description="Erfahren Sie mehr über Mr. Nice Vape Deutschland: ein Online-Vape-Shop aus Köln mit Originalprodukten, ehrlicher Beratung und Versand in ganz Deutschland.">
  <Fragment slot="head">
    <meta name="keywords" content="über mrnicevape, vape shop köln, online vape shop deutschland, vapes online kaufen, mrnicevape deutschland" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "name": "Über Mr. Nice Vape Deutschland",
      "description": "Erfahren Sie mehr über Mr. Nice Vape Deutschland — einen Online-Vape-Shop aus Köln, NRW.",
      "url": "https://mrnicevape.com/about",
      "isPartOf": { "@type": "WebSite", "@id": "https://mrnicevape.com/#website" },
      "about": {
        "@type": "Store",
        "name": "Mr. Nice Vape Deutschland",
        "url": "https://mrnicevape.com",
        "logo": "https://mrnicevape.com/images/logo.svg",
        "image": "https://mrnicevape.com/images/logo.svg",
        "description": "Online-Vape-Shop aus Köln für Vape-Kits, Einweg-Vapes, E-Liquids, Coils, Pods und Zubehör führender Marken.",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Musterstraße 12",
          "addressLocality": "Köln",
          "addressRegion": "NRW",
          "postalCode": "50667",
          "addressCountry": "DE"
        },
        "telephone": "+492211234567",
        "email": "info@mrnicevape.com",
        "foundingDate": "2019",
        "priceRange": "$$",
        "currenciesAccepted": "EUR",
        "paymentAccepted": "Banküberweisung, SEPA, Bitcoin",
        "openingHoursSpecification": [
          { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "10:30", "closes": "19:30" },
          { "@type": "OpeningHoursSpecification", "dayOfWeek": "Samstag", "opens": "10:30", "closes": "18:00" },
          { "@type": "OpeningHoursSpecification", "dayOfWeek": "Sonntag", "opens": "10:30", "closes": "16:00" }
        ]
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://mrnicevape.com/" },
          { "@type": "ListItem", "position": 2, "name": "Über uns", "item": "https://mrnicevape.com/about" }
        ]
      }
    })} />
  </Fragment>

  <!-- Breadcrumb -->
  <nav class="breadcrumb-bar" aria-label="Breadcrumb">
    <div class="container">
      <ol class="breadcrumb">
        <li><a href="/">Startseite</a></li>
        <li><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg></li>
        <li><span class="breadcrumb-current">Über uns</span></li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="about-hero">
    <div class="about-hero-pattern"></div>
    <div class="container about-hero-inner">
      <div class="about-hero-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        Köln, NRW — seit 2019
      </div>
      <h1 class="font-display about-hero-title">Wir sind <span class="about-hero-accent">Mr. Nice Vape</span>.</h1>
      <p class="about-hero-desc">Ein Vape-Shop aus Köln, aufgebaut für Menschen, die Qualität, klare Beratung und eine gute Produktauswahl schätzen. Seit 2019 helfen wir Kundinnen und Kunden in Deutschland, das passende Setup zu finden.</p>
      <div class="about-hero-pills">
        <span class="about-pill"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg> 100% Originalprodukte</span>
        <span class="about-pill"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 5v3h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg> Deutschlandweite Lieferung</span>
        <span class="about-pill"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> Vertrauenswürdig seit 2019</span>
      </div>
    </div>
  </section>

  <!-- Stats Bar -->
  <section class="about-stats-bar">
    <div class="container">
      <div class="about-stats">
        <div class="about-stat">
          <span class="about-stat-number font-display">2019</span>
          <span class="about-stat-label">Gegründet</span>
        </div>
        <div class="about-stat-divider"></div>
        <div class="about-stat">
          <span class="about-stat-number font-display">1,500+</span>
          <span class="about-stat-label">Produkte</span>
        </div>
        <div class="about-stat-divider"></div>
        <div class="about-stat">
          <span class="about-stat-number font-display">50+</span>
          <span class="about-stat-label">Top-Marken</span>
        </div>
        <div class="about-stat-divider"></div>
        <div class="about-stat">
          <span class="about-stat-number font-display">24/7</span>
          <span class="about-stat-label">Online-Shop</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Story -->
  <section class="about-story">
    <div class="container">
      <div class="about-story-grid">
        <div class="about-story-content">
          <span class="about-section-label">Unsere Geschichte</span>
          <h2 class="font-display about-story-title">Mehr als nur ein Vape-Shop</h2>
          <p class="about-story-text">Wir haben Mr. Nice Vape 2019 mit einer einfachen Idee gestartet: ein Vape-Shop, der Kundinnen und Kunden so berät, wie wir selbst beraten werden möchten. Deshalb setzen wir auf <strong>originale Qualitätsprodukte</strong>, ehrliche Empfehlungen und verständliche Informationen.</p>
          <p class="about-story-text">Heute beliefern wir Kundinnen und Kunden in ganz Deutschland — mit einem kuratierten Sortiment, zuverlässigem Versand und einem Online-Shop, der rund um die Uhr erreichbar ist.</p>
        </div>
        <div class="about-story-visual">
          <div class="about-story-card-stack">
            <div class="about-story-mini-card">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.5"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              <div>
                <strong>Köln, NRW</strong>
                <span>Musterstraße 12, 50667</span>
              </div>
            </div>
            <div class="about-story-mini-card">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
              <div>
                <strong>Online rund um die Uhr</strong>
                <span>Beratung an Werktagen</span>
              </div>
            </div>
            <div class="about-story-mini-card">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
              <div>
                <strong>100% Originalware</strong>
                <span>Jedes Produkt ist original</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Us Cards -->
  <section class="about-features">
    <div class="container">
      <div class="about-features-header">
        <span class="about-section-label">Warum Mr. Nice Vape</span>
        <h2 class="font-display about-features-title">Was uns auszeichnet</h2>
      </div>
      <div class="about-grid">
        <div class="about-card">
          <div class="about-card-number font-display">01</div>
          <div class="about-card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <h3 class="font-display about-card-title">Besuche unseren Shop</h3>
          <p class="about-card-text">Unser Team sitzt in <strong>Köln</strong> und betreut Bestellungen aus ganz Deutschland. Der Online-Shop ist rund um die Uhr erreichbar, damit Sie bestellen können, wann es passt.</p>
          <div class="about-card-footer">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>Musterstraße 12, 50667 Köln</span>
          </div>
        </div>

        <div class="about-card">
          <div class="about-card-number font-display">02</div>
          <div class="about-card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <h3 class="font-display about-card-title">100% Originalprodukte</h3>
          <p class="about-card-text">Unsere Produkte stammen aus <strong>geprüften Bezugsquellen</strong>. Keine zweifelhaften Importe, keine unklare Herkunft: Bei Mr. Nice Vape wissen Sie, was Sie kaufen.</p>
          <div class="about-card-footer">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
            <span>SMOK, Vaporesso, GeekVape, Voopoo, Uwell &amp; mehr</span>
          </div>
        </div>

        <div class="about-card">
          <div class="about-card-number font-display">03</div>
          <div class="about-card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 5v3h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          </div>
          <h3 class="font-display about-card-title">Deutschlandweit Versand</h3>
          <p class="about-card-text">Wir liefern in alle Bundesländer. Wählen Sie an der Kasse <strong>Standardversand (5–10 Werktage)</strong> oder <strong>Expressversand (2–4 Werktage)</strong> — zuverlässig und nachverfolgbar.</p>
          <div class="about-card-footer">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            <span>Standard- und Expressoptionen verfügbar</span>
          </div>
        </div>

        <div class="about-card">
          <div class="about-card-number font-display">04</div>
          <div class="about-card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3 class="font-display about-card-title">Echte Beratung</h3>
          <p class="about-card-text">Fragen zur Kompatibilität, zur passenden Nikotinstärke oder zum nächsten Upgrade? <strong>Schreiben Sie uns.</strong> Unser Team hilft mit klaren Empfehlungen statt Standardantworten.</p>
          <div class="about-card-footer">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <span>info@mrnicevape.com</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Hours & Location -->
  <section class="about-location">
    <div class="container">
      <div class="about-location-grid">
        <!-- Hours Card -->
        <div class="about-hours-card">
          <div class="about-hours-header">
            <div class="about-hours-icon-wrap">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            </div>
            <div>
              <h2 class="font-display about-hours-title">Öffnungszeiten</h2>
              <p class="about-hours-subtitle">Unser Team in Köln</p>
            </div>
          </div>
          <div class="about-hours-grid">
            <div class="about-hours-row">
              <span class="about-hours-day">Montag – Freitag</span>
              <span class="about-hours-time">10:30 – 19:30 Uhr</span>
            </div>
            <div class="about-hours-row">
              <span class="about-hours-day">Samstag</span>
              <span class="about-hours-time">10:30 – 18:00 Uhr</span>
            </div>
            <div class="about-hours-row">
              <span class="about-hours-day">Sonntag</span>
              <span class="about-hours-time">10:30 – 16:00 Uhr</span>
            </div>
            <div class="about-hours-row about-hours-closed">
              <span class="about-hours-day">Feiertage</span>
              <span class="about-hours-time closed">Geschlossen</span>
            </div>
          </div>
          <p class="about-hours-note">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
            An Feiertagen können die Zeiten abweichen. Der Online-Shop ist jederzeit geöffnet.
          </p>
        </div>

        <!-- Delivery Info Card -->
        <div class="about-delivery-card">
          <div class="about-delivery-header">
            <div class="about-delivery-icon-wrap">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 5v3h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </div>
            <div>
              <h2 class="font-display about-delivery-title">Lieferoptionen</h2>
              <p class="about-delivery-subtitle">Wir versenden deutschlandweit</p>
            </div>
          </div>
          <div class="about-delivery-options">
            <div class="about-delivery-option">
              <div class="about-delivery-option-header">
                <span class="about-delivery-option-name font-display">Standard Versand</span>
                <span class="about-delivery-option-price font-display">€9,95</span>
              </div>
              <span class="about-delivery-option-time">5–10 Werktage · Sendungsverfolgung</span>
            </div>
            <div class="about-delivery-option express">
              <div class="about-delivery-option-header">
                <span class="about-delivery-option-name font-display">Express Versand</span>
                <span class="about-delivery-option-price font-display">€14,95</span>
              </div>
              <span class="about-delivery-option-time">2–4 Werktage · priorisierte Sendungsverfolgung</span>
            </div>
          </div>
          <p class="about-delivery-note">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            Alle Bestellungen werden aus Köln in alle Bundesländer versendet.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="about-cta-section">
    <div class="container">
      <div class="about-cta-box">
        <div class="about-cta-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <h2 class="font-display about-cta-title">Wir beraten Sie gern</h2>
        <p class="about-cta-desc">Ob Einstieg, Upgrade oder Ersatzteilfrage: Unser Team hilft Ihnen gern weiter. Schreiben Sie uns eine E-Mail oder stöbern Sie direkt im Online-Shop.</p>
        <div class="about-cta-actions">
          <a href="/collections/shop" class="btn-primary about-cta-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            Jetzt einkaufen
          </a>
          <a href="/contact" class="btn-secondary about-cta-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            Kontakt
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .breadcrumb-bar { background: var(--color-surface); border-bottom: 1px solid var(--color-border); padding: 0.85rem 0; }
  .breadcrumb { display: flex; align-items: center; gap: 0.45rem; flex-wrap: wrap; font-size: 0.8rem; list-style: none; }
  .breadcrumb a { color: var(--color-text-secondary); text-decoration: none; transition: color 0.15s ease; }
  .breadcrumb a:hover { color: var(--color-accent); }
  .breadcrumb svg { color: var(--color-text-dim); }
  .breadcrumb-current { color: var(--color-text); font-weight: 500; }

  /* ── Hero ── */
  .about-hero {
    position: relative;
    padding: 5rem 0 4rem;
    text-align: center;
    background: linear-gradient(180deg, #F0FDF4 0%, #DCFCE7 40%, var(--color-bg) 100%);
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }
  [data-theme="dark"] .about-hero {
    background: linear-gradient(180deg, rgba(22,163,74,0.08) 0%, rgba(22,163,74,0.03) 40%, var(--color-bg) 100%);
  }
  .about-hero-pattern {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 1px 1px, rgba(22,163,74,0.07) 1px, transparent 0);
    background-size: 32px 32px;
    pointer-events: none;
  }
  .about-hero-inner { position: relative; z-index: 1; }
  .about-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 1rem;
    background: rgba(22,163,74,0.1);
    border: 1px solid rgba(22,163,74,0.2);
    border-radius: 100px;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: 1.25rem;
  }
  .about-hero-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: 0.75rem;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .about-hero-accent {
    background: linear-gradient(135deg, var(--color-accent), #059669);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .about-hero-desc {
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    max-width: 600px;
    margin: 0 auto 1.75rem;
    line-height: 1.7;
  }
  .about-hero-pills {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .about-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.85rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }
  .about-pill svg { color: var(--color-accent); }

  /* ── Stats Bar ── */
  .about-stats-bar {
    padding: 0;
    margin-top: -1.5rem;
    position: relative;
    z-index: 2;
  }
  .about-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 1.5rem 2rem;
    box-shadow: 0 8px 32px rgba(0,0,0,0.06);
    max-width: 680px;
    margin: 0 auto;
  }
  .about-stat {
    flex: 1;
    text-align: center;
    padding: 0.5rem 0;
  }
  .about-stat-divider {
    width: 1px;
    height: 40px;
    background: var(--color-border);
    flex-shrink: 0;
  }
  .about-stat-number {
    display: block;
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-accent);
    letter-spacing: -0.02em;
  }
  .about-stat-label {
    display: block;
    font-size: 0.72rem;
    color: var(--color-text-muted);
    font-weight: 600;
    margin-top: 0.15rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  @media (max-width: 480px) {
    .about-stats { flex-wrap: wrap; padding: 1.25rem; gap: 0.5rem; }
    .about-stat-divider { display: none; }
    .about-stat { flex: 0 0 45%; }
  }

  /* ── Story Section ── */
  .about-story { padding: 4rem 0 3rem; }
  .about-section-label {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-accent);
    text-transform: uppercase;
