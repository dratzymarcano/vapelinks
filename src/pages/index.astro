---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import CollectionCard from '../components/CollectionCard.astro';
import siteData from '../data/site.json';
import productsRaw from '../data/products.json';
import disposableVapes from '../data/disposable-vapes.json';
const productsData = [...productsRaw, ...disposableVapes] as any[];
import collectionsData from '../data/collections.json';

const featuredProducts = productsData
  .filter((p: any) => p.images.length > 0)
  .slice(0, 8);

const topCollections = collectionsData
  .filter((c: any) => c.products_count > 5)
  .sort((a: any, b: any) => b.products_count - a.products_count)
  .slice(0, 6);

const saleProducts = productsData
  .filter((p: any) => {
    const v = p.variants[0];
    return v && v.compare_at_price && parseFloat(v.compare_at_price) > parseFloat(v.price);
  })
  .slice(0, 4);

const productTypes = [...new Set(productsData.map((p: any) => p.product_type).filter(Boolean))] as string[];
const vendors = [...new Set(productsData.map((p: any) => p.vendor).filter(Boolean))] as string[];
---

<Layout
  title="Mr. Nice Vape — Deutschlands Online-Vape-Shop | Vapes in Köln kaufen"
  description="Mr. Nice Vape ist ein Online-Vape-Shop aus Köln für Vape-Kits, Einweg-Vapes, E-Liquids, Coils, Pods und Zubehör von SMOK, Vaporesso, GeekVape und mehr. Schneller Versand deutschlandweit."
>

  <!-- Structured Data: Organization + WebSite + SearchAction -->
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://mrnicevape.com/#organization",
          "name": "Mr. Nice Vape Deutschland",
          "alternateName": "Mr. Nice Vape",
          "url": "https://mrnicevape.com",
          "logo": {
            "@type": "ImageObject",
            "url": "https://mrnicevape.com/images/logo.svg",
            "width": 200,
            "height": 60
          },
          "description": "Online-Vape-Shop aus Köln für Vape-Kits, Einweg-Vapes, E-Liquids, Coils und Zubehör mit Versand deutschlandweit.",
          "email": "info@mrnicevape.com",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Köln",
            "addressRegion": "NRW",
            "addressCountry": "DE"
          },
          "areaServed": {
            "@type": "Country",
            "name": "Deutschland"
          }
        },
        {
          "@type": "WebSite",
          "@id": "https://mrnicevape.com/#website",
          "url": "https://mrnicevape.com",
          "name": "Mr. Nice Vape Deutschland",
          "description": "Online-Vape-Shop aus Köln, Deutschland",
          "publisher": { "@id": "https://mrnicevape.com/#organization" },
          "potentialAction": {
            "@type": "SearchAction",
            "target": {
              "@type": "EntryPoint",
              "urlTemplate": "https://mrnicevape.com/search?q={search_term_string}"
            },
            "query-input": "required name=search_term_string"
          }
        },
        {
          "@type": "Store",
          "@id": "https://mrnicevape.com/#store",
          "name": "Mr. Nice Vape Vape Shop",
          "image": "https://mrnicevape.com/images/logo.svg",
          "url": "https://mrnicevape.com",
          "email": "info@mrnicevape.com",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Köln",
            "addressLocality": "Köln",
            "addressRegion": "NRW",
            "postalCode": "50667",
            "addressCountry": "DE"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": 50.9375,
            "longitude": 6.9603
          },
          "priceRange": "$$",
          "currenciesAccepted": "EUR",
          "paymentAccepted": "Banküberweisung, SEPA, Bitcoin",
          "areaServed": "Deutschland"
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [{
            "@type": "ListItem",
            "position": 1,
            "name": "Startseite",
            "item": "https://mrnicevape.com/"
          }]
        }
      ]
    })} />
  </Fragment>

  <!-- ═══ HERO ═══ -->
  <section class="hero">
    <div class="hero-bg">
      <img src="/images/hero-bg.jpg" alt="Mr. Nice Vape Deutschland — Premium-Vape-Produkte" loading="eager" fetchpriority="high" />
    </div>
    <div class="hero-overlay"></div>
    <div class="container hero-content">
      <div class="hero-badge">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
        Aus Köln · Versand deutschlandweit · Online rund um die Uhr
      </div>
      <h1 class="font-display hero-title">
        Deutschlands #1<br/>
        <span class="hero-accent">Online-Vape-Shop</span>
      </h1>
      <p class="hero-desc">
        {productsData.length.toLocaleString()}+ Produkte: Vape-Kits, Einweg-Vapes, E-Liquids, Coils und Zubehör von SMOK, Vaporesso, GeekVape und mehr. Schneller Standard- und Expressversand deutschlandweit.
      </p>
      <div class="hero-actions">
        <a href="/collections/shop" class="btn-primary" style="padding:0.9rem 2.25rem;font-size:0.95rem;border-radius:var(--radius-md);">
          Alle Produkte ansehen
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a href="/collections" class="hero-btn-outline">
          Kategorien ansehen
        </a>
      </div>
      <div class="hero-brands">
        <span class="hero-brands-label">Vertrauenswürdige Marken</span>
        <div class="hero-brands-list">
          <span>SMOK</span>
          <span>Vaporesso</span>
          <span>GeekVape</span>
          <span>Voopoo</span>
          <span>Uwell</span>
          <span>Aspire</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ TRUST STRIP ═══ -->
  <section class="trust-strip">
    <div class="container">
      <div class="trust-grid">
        <div class="trust-item">
          <div class="trust-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
          </div>
          <div class="trust-info">
            <span class="trust-number font-display">{productsData.length.toLocaleString()}</span>
            <span class="trust-label">Produkte auf Lager</span>
          </div>
        </div>
        <div class="trust-sep"></div>
        <div class="trust-item">
          <div class="trust-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          </div>
          <div class="trust-info">
            <span class="trust-number font-display">{topCollections.length}+</span>
            <span class="trust-label">Kategorien</span>
          </div>
        </div>
        <div class="trust-sep"></div>
        <div class="trust-item">
          <div class="trust-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
          </div>
          <div class="trust-info">
            <span class="trust-number font-display">{vendors.length}+</span>
            <span class="trust-label">Top-Marken</span>
          </div>
        </div>
        <div class="trust-sep"></div>
        <div class="trust-item">
          <div class="trust-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div class="trust-info">
            <span class="trust-number font-display">CGN</span>
            <span class="trust-label">Sitz in Köln</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ FEATURES STRIP ═══ -->
  <section class="features-section">
    <div class="container">
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon-wrap">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 5v3h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          </div>
          <div class="feature-content">
            <strong class="feature-title">Schneller Versand</strong>
            <span class="feature-desc">Standard- und Expresslieferung in Deutschland</span>
          </div>
        </div>
        <div class="feature-card">
          <div class="feature-icon-wrap">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <div class="feature-content">
            <strong class="feature-title">100% Originalware</strong>
            <span class="feature-desc">Authentische Produkte von geprüften Bezugsquellen</span>
          </div>
        </div>
        <div class="feature-card">
          <div class="feature-icon-wrap">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 1 0-16 0"/><path d="M12 13v2"/><path d="M12 17h.01"/></svg>
          </div>
          <div class="feature-content">
            <strong class="feature-title">Kompetente Beratung</strong>
            <span class="feature-desc">Echte Hilfe von einem erfahrenen Team</span>
          </div>
        </div>
        <div class="feature-card">
          <div class="feature-icon-wrap">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div class="feature-content">
            <strong class="feature-title">Deutschlandweit</strong>
            <span class="feature-desc">Schnelle Bearbeitung aus Köln an Werktagen</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ COLLECTIONS ═══ -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="section-label">Kategorien</span>
          <h2 class="font-display section-title">Nach Kategorie einkaufen</h2>
        </div>
        <a href="/collections" class="section-link">
          Alle ansehen
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
      <div class="collections-grid stagger-children">
        {topCollections.map((collection: any) => (
          <CollectionCard collection={collection} />
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FEATURED PRODUCTS ═══ -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="section-label">Empfohlene Produkte</span>
          <h2 class="font-display section-title">Neu eingetroffen</h2>
        </div>
        <a href="/collections/shop" class="section-link">
          Alle Produkte
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
      <div class="products-grid stagger-children">
        {featuredProducts.map((product: any) => (
          <ProductCard product={product} />
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ ON SALE ═══ -->
  {saleProducts.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-header">
          <div style="display:flex;align-items:center;gap:0.75rem;">
            <span class="badge-sale" style="font-size:0.72rem;padding:0.3rem 0.75rem;">SALE</span>
            <div>
              <span class="section-label">Sale</span>
              <h2 class="font-display section-title">Reduzierte Produkte</h2>
            </div>
          </div>
          <a href="/collections/all-clearance" class="section-link">
            Sale ansehen
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
        <div class="products-grid stagger-children">
          {saleProducts.map((product: any) => (
            <ProductCard product={product} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ═══ CATEGORIES / TAGS ═══ -->
  <section class="section section-alt">
    <div class="container" style="text-align:center;">
      <span class="section-label">Stöbern</span>
      <h2 class="font-display section-title" style="margin-bottom:1.75rem;">Produkttypen</h2>
      <div class="tags-cloud">
        {productTypes.sort().map((type: string) => (
          <a href="/collections/shop" class="tag-pill">{type}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ ABOUT / CTA ═══ -->
  <section class="section">
    <div class="container">
      <div class="cta-card">
        <div class="cta-inner">
          <span class="section-label">Über Mr. Nice Vape</span>
          <h2 class="font-display" style="font-size:1.65rem;font-weight:700;color:var(--color-text);margin:0.5rem 0 0.75rem;">Über Mr. Nice Vape</h2>
          <p style="color:var(--color-text-secondary);line-height:1.8;max-width:560px;margin:0 auto 1rem;font-size:0.92rem;">
            Mr. Nice Vape ist ein Vape-Shop aus Köln und seit 2019 auf hochwertige E-Zigaretten, E-Liquids und Zubehör spezialisiert. Wir führen {productsData.length.toLocaleString()}+ Produkte von {vendors.length}+ Marken, von Starter-Kits und Einweg-Vapes bis zu Coils, Pods und Zubehör.
          </p>
          <p style="color:var(--color-text-secondary);line-height:1.8;max-width:560px;margin:0 auto 1.75rem;font-size:0.92rem;">
            Bestellen Sie bequem online: Wir liefern deutschlandweit mit Standard- und Expressoptionen. Wenn Sie unsicher sind, welches Produkt passt, hilft unser Team gern mit ehrlicher Empfehlung weiter.
          </p>
          <a href={`mailto:${siteData.contact_email}`} class="btn-primary" style="padding:0.75rem 2rem;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            Kontakt aufnehmen
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ SEO CONTENT: Why Choose Mr. Nice Vape ═══ -->
  <section class="section section-alt">
    <div class="container">
      <div class="seo-content">
        <h2 class="font-display" style="font-size:1.5rem;font-weight:700;color:var(--color-text);margin-bottom:1.5rem;text-align:center;">Warum bei uns kaufen?</h2>
        <div class="seo-grid">
          <div class="seo-block">
            <h3 class="font-display" style="font-size:1rem;font-weight:600;color:var(--color-text);margin-bottom:0.5rem;">Riesige Auswahl — {productsData.length.toLocaleString()}+ Produkte</h3>
            <p>Unser Sortiment umfasst <a href="/collections/shop">Vape-Produkte</a>, <a href="/collections/all-vape-kits">Starter-Kits</a>, <a href="/pages/disposable-vapes-deutschland">Einweg-Vapes</a>, E-Liquids, Coils, Pods und Mods. {vendors.length}+ Marken sind an einem Ort verfügbar.</p>
          </div>
          <div class="seo-block">
            <h3 class="font-display" style="font-size:1rem;font-weight:600;color:var(--color-text);margin-bottom:0.5rem;">Versand in alle Bundesländer</h3>
            <p>Wir versenden aus Köln in ganz Deutschland. Standardversand dauert in der Regel 5–10 Werktage (€9,95), Expressversand 2–4 Werktage (€14,95). Weitere Details finden Sie auf unserer <a href="/pages/shipping-policy">Versandseite</a>.</p>
          </div>
          <div class="seo-block">
            <h3 class="font-display" style="font-size:1rem;font-weight:600;color:var(--color-text);margin-bottom:0.5rem;">Nur originale Ware</h3>
            <p>Wir setzen auf Originalware von geprüften Bezugsquellen. SMOK, Vaporesso, GeekVape, Voopoo, Uwell, Aspire, Innokin, FreeMax und viele weitere Marken sind sauber sortiert und transparent beschrieben.</p>
          </div>
          <div class="seo-block">
            <h3 class="font-display" style="font-size:1rem;font-weight:600;color:var(--color-text);margin-bottom:0.5rem;">Beratung von Menschen mit Produkterfahrung</h3>
            <p>Fragen zu Kompatibilität, Nikotinstärke oder passenden Ersatzteilen? Unser Team kennt das Sortiment und hilft Ihnen gern mit einer klaren Empfehlung. <a href="/contact">Kontakt aufnehmen</a>.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ SEO: Location Pages ═══ -->
  <section class="section">
    <div class="container" style="text-align:center;">
      <span class="section-label">Wir liefern deutschlandweit</span>
      <h2 class="font-display section-title" style="margin-bottom:1.75rem;">Vape-Lieferung in ganz Deutschland</h2>
      <div class="tags-cloud">
        <a href="/about" class="tag-pill">Köln Vape Shop</a>
        <a href="/collections/shop" class="tag-pill">Vapes online kaufen</a>
        <a href="/collections/all-vape-kits" class="tag-pill">Vape-Kits kaufen</a>
        <a href="/pages/disposable-vapes-deutschland" class="tag-pill">Einweg-Vapes Deutschland</a>
        <a href="/collections/all-e-liquid" class="tag-pill">E-Liquids online</a>
        <a href="/collections/all-coils" class="tag-pill">Coils & Ersatzteile</a>
        <a href="/collections/all-pod-kits" class="tag-pill">Pod-Systeme</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    padding: 8.5rem 0 7.5rem;
    overflow: hidden;
    min-height: 680px;
    display: flex;
    align-items: center;
  }
  @media (max-width: 640px) {
    .hero {
      padding: 5rem 0 4.5rem;
      min-height: 520px;
    }
    .hero-title { font-size: 2.2rem; }
    .hero-desc { font-size: 0.92rem; }
    .hero-actions { flex-direction: column; align-items: center; }
    .hero-actions .btn-primary,
    .hero-actions .hero-btn-outline { width: 100%; max-width: 300px; justify-content: center; }
    .hero-brands { flex-direction: column; gap: 0.5rem; }
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(ellipse at 15% 55%, rgba(22, 163, 74, 0.25) 0%, transparent 55%),
      radial-gradient(ellipse at 85% 20%, rgba(22, 163, 74, 0.12) 0%, transparent 45%),
      linear-gradient(105deg, rgba(4, 9, 25, 0.95) 0%, rgba(8, 20, 55, 0.88) 35%, rgba(12, 30, 70, 0.72) 65%, rgba(8, 16, 45, 0.75) 100%);
  }
  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    animation: slide-up 0.5s var(--ease-out) both;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: #86efac;
    background: rgba(22, 163, 74, 0.18);
    padding: 0.5rem 1.2rem;
    border-radius: var(--radius-full);
    border: 1px solid rgba(22, 163, 74, 0.35);
    margin-bottom: 1.5rem;
    backdrop-filter: blur(8px);
  }
  .hero-title {
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.05;
    margin-bottom: 1.35rem;
    letter-spacing: -0.03em;
    text-shadow: 0 4px 32px rgba(0,0,0,0.45);
  }
  .hero-accent {
    background: linear-gradient(135deg, #86efac 0%, #4ade80 50%, #22c55e 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero-desc {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.85);
    max-width: 520px;
    margin: 0 auto 2rem;
    line-height: 1.7;
  }
  .hero-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .hero-btn-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.9rem 2rem;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
    border: 1.5px solid rgba(255, 255, 255, 0.22);
    border-radius: var(--radius-md);
    text-decoration: none;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s var(--ease-out);
    backdrop-filter: blur(8px);
  }
  .hero-btn-outline:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.5);
    transform: translateY(-1px);
  }

  .hero-brands {
    margin-top: 2.75rem;
    display: flex;
